<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.javajungle.ModeSelectController" styleClass="app-root, mode-root">
    <center>
        <StackPane styleClass="screen-frame, jungle-bg">
            <Region styleClass="jungle-overlay" mouseTransparent="true" />

            <VBox styleClass="pick-terminal" spacing="22" alignment="CENTER">
                <HBox styleClass="pick-topbar" alignment="CENTER_LEFT" spacing="20">
                    <Button text="← BACK" onAction="#handleBack" styleClass="button-quiet" />
                    <Label text="Java Jungle" styleClass="game-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="playerStatusLabel" text="Welcome, explorer" styleClass="pick-welcome" />
                    <ProgressBar fx:id="levelProgressBar" progress="0.0" prefWidth="92" styleClass="trail-xp-bar" />
                    <Label fx:id="levelLabel" text="Lv 1" styleClass="trail-rank" />
                    <Label fx:id="heartsLabel" text="♥  ♥  ♥" styleClass="hearts" />
                    <Label fx:id="xpLabel" text="0 XP" styleClass="accent-green" />
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox styleClass="pick-heading-box" spacing="6" alignment="CENTER" maxWidth="440">
                    <Label text="Choose your trail" styleClass="pick-heading" />
                    <Label text="Pick an expedition to begin" styleClass="pick-subheading" />
                </VBox>

                <HBox spacing="28" alignment="CENTER">
                    <VBox styleClass="pick-card" spacing="14" prefWidth="440" minWidth="440" maxWidth="440" prefHeight="300" minHeight="300">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Story mode" styleClass="pick-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <SVGPath content="M9 2 A7 7 0 1 0 9 16 A7 7 0 1 0 9 2 M14 14 L21 21" styleClass="pick-icon-green" />
                        </HBox>
                        <Label text="Investigate coding errors through story cases, then fix the code in the editor." styleClass="pick-copy" wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pick-path">
                            <Label text="Profile" styleClass="pick-chip" />
                            <Label text="›" styleClass="pick-arrow" />
                            <Label text="Case search" styleClass="pick-chip" />
                            <Label text="›" styleClass="pick-arrow" />
                            <Label text="Editor" styleClass="pick-chip" />
                        </HBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Button text="Enter story mode  →" onAction="#handleStoryMode" styleClass="pick-button, pick-button-fill" prefWidth="260" prefHeight="48" />
                    </VBox>

                    <VBox styleClass="pick-card" spacing="14" prefWidth="440" minWidth="440" maxWidth="440" prefHeight="300" minHeight="300">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Chapter mode" styleClass="pick-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <SVGPath content="M11 2 A9 9 0 1 0 11 20 A9 9 0 1 0 11 2 M11 6 L14 11 L11 16 L8 11 Z" styleClass="pick-icon-gold" />
                        </HBox>
                        <Label text="Pick a chapter, choose a level and answer questions on each Java topic." styleClass="pick-copy" wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pick-path">
                            <Label text="Chapter" styleClass="pick-chip" />
                            <Label text="›" styleClass="pick-arrow" />
                            <Label text="Level" styleClass="pick-chip" />
                            <Label text="›" styleClass="pick-arrow" />
                            <Label text="Questions" styleClass="pick-chip" />
                        </HBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Button text="Enter chapter mode  →" onAction="#handleChapterMode" styleClass="pick-button, pick-button-outline" prefWidth="260" prefHeight="48" />
                    </VBox>
                </HBox>

                <Label fx:id="progressSummaryLabel" text="Select a trail to continue" styleClass="pick-hint" />

                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
